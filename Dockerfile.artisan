FROM debian:bookworm-slim

ARG VERSION

# 安装所有依赖：xvfb xauth + Qt + 系统库
RUN apt update && apt install -y --no-install-recommends \
    wget \
    curl \
    ca-certificates \
    xvfb \
    xauth \
    libqt5core5a \
    libqt5gui5 \
    libqt5widgets5 \
    libqt5serialport5 \
    libqt5network5 \
    libqt5printsupport5 \
    libqt5svg5 \
    libmodbus-dev \
    libusb-1.0-0-dev \
    udev \
    && rm -rf /var/lib/apt/lists/*

# 下载 + 安装（强制成功）
RUN cd /tmp && \
    wget -O artisan.deb https://github.com/artisan-roaster-scope/artisan/releases/download/${VERSION}/artisan-linux-${VERSION#v}.deb && \
    dpkg -i artisan.deb || apt -f install -y && \
    rm -f artisan.deb

# 测试是否安装成功（留痕）
RUN which artisan || exit 1

# 启动命令（稳定版）
CMD xvfb-run -a /usr/local/bin/artisan --web --web-host 0.0.0.0 --web-port 8080
