FROM ubuntu:22.04

ARG VERSION

# ==========================================
# 1. 基础环境准备
# ==========================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 2. 下载 Artisan
# ==========================================
RUN \
    STRIPPED_VERSION=${VERSION#v} && \
    DOWNLOAD_URL="https://github.com/artisan-roaster-scope/artisan/releases/download/${VERSION}/artisan-linux-${STRIPPED_VERSION}.deb" && \
    echo "📥 正在下载: ${DOWNLOAD_URL}" && \
    wget -O /tmp/artisan.deb "${DOWNLOAD_URL}" && \
    ls -lh /tmp/artisan.deb && \
    sha256sum /tmp/artisan.deb

# ==========================================
# 3. 安装依赖
# ==========================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl xvfb xauth \
    libqt5core5a \
    libqt5gui5 \
    libqt5widgets5 \
    libqt5serialport5 \
    libqt5network5 \
    libqt5printsupport5 \
    libqt5svg5 \
    libqt5multimedia5 \
    libqt5multimedia5-plugins \
    python3 \
    python3-pyqt5 \
    python3-pyqt5.qtserialport \
    python3-serial \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    libmodbus-dev \
    libusb-1.0-0-dev \
    udev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 4. 安装 Artisan
# ==========================================
RUN apt-get install -y -f /tmp/artisan.deb || \
    (dpkg -i /tmp/artisan.deb && apt-get -f install -y) || \
    true && \
    rm -f /tmp/artisan.deb

# ==========================================
# 5. 寻找文件 (关键修改)
# ==========================================
# 1. 列出 dpkg 安装的所有文件
RUN echo "🔍 正在查询 dpkg 安装记录..." && \
    dpkg -L artisan 2>/dev/null || echo "⚠️ dpkg 未记录 artisan 包"

# 2. 全盘搜索 artisan 可执行文件
RUN echo "🔍 正在全盘搜索 artisan 文件..." && \
    find / -name "artisan*" -type f 2>/dev/null

# 3. 尝试建立软链接 (如果找到了)
# 假设它可能被安装在 /usr/bin/artisan 或 /opt/...
RUN \
    FOUND_PATH=$(find / -name "artisan" -type f 2>/dev/null | head -n 1) && \
    if [ -n "$FOUND_PATH" ]; then \
      echo "✅ 找到文件: $FOUND_PATH"; \
      ln -sf "$FOUND_PATH" /usr/local/bin/artisan; \
    else \
      echo "❌ 未找到 artisan 可执行文件"; \
      exit 1; \
    fi

# ==========================================
# 6. 验证
# ==========================================
RUN if [ ! -L /usr/local/bin/artisan ] && [ ! -f /usr/local/bin/artisan ]; then \
      echo "❌ 最终验证失败：链接或文件仍不存在"; exit 1; \
    fi

CMD ["xvfb-run", "-a", "/usr/local/bin/artisan", "--web", "--web-host", "0.0.0.0", "--web-port", "8080"]
