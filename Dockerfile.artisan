FROM debian:bookworm-slim

ARG VERSION

# ==========================================
# 1. 修复源地址 & 安装基础工具
# ==========================================
RUN sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# ==========================================
# 2. 下载 Artisan
# ==========================================
RUN \
    STRIPPED_VERSION=${VERSION#v} && \
    DOWNLOAD_URL="https://github.com/artisan-roaster-scope/artisan/releases/download/${VERSION}/artisan-linux-${STRIPPED_VERSION}.deb" && \
    echo "📥 正在下载: ${DOWNLOAD_URL}" && \
    wget -q --show-progress -O /tmp/artisan.deb "${DOWNLOAD_URL}"

# ==========================================
# 3. 强制安装 (关键修复点)
# ==========================================
# 先更新源（确保修复依赖时能上网），然后尝试安装，不管 dpkg 成功与否，都运行 apt-get -f install
RUN sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    # 关键：使用 || true 确保即使 dpkg 失败，构建也不会在这里中断
    dpkg -i /tmp/artisan.deb || true && \
    # 强制运行 apt-get -f install 来修复依赖并完成安装
    apt-get -f install -y && \
    rm -f /tmp/artisan.deb

# ==========================================
# 4. 验证
# ==========================================
RUN if [ ! -f /usr/local/bin/artisan ]; then \
      echo "❌ 安装失败：找不到二进制文件"; exit 1; \
    fi

CMD ["xvfb-run", "-a", "/usr/local/bin/artisan", "--web", "--web-host", "0.0.0.0", "--web-port", "8080"]
