FROM ubuntu:22.04

# ==========================================
# 1. 环境准备与依赖安装
# ==========================================
# 关键：必须安装 libfuse2，否则 AppImage 无法运行
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    libfuse2 \
    libglib2.0-0 \
    libgl1-mesa-glx \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libxfixes3 \
    libxi6 \
    libxxf86vm1 \
    python3 \
    python3-pyqt5 \
    python3-serial \
    python3-requests \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 2. 下载 AppImage
# ==========================================
ARG VERSION=v4.0.2
ENV ARTISAN_URL="https://github.com/artisan-roaster-scope/artisan/releases/download/${VERSION}/artisan-linux-${VERSION#v}.AppImage"

RUN cd /tmp && \
    wget -O /tmp/artisan.AppImage "${ARTISAN_URL}" && \
    chmod +x /tmp/artisan.AppImage

# ==========================================
# 3. 启动命令
# ==========================================
# 直接运行 AppImage，并传入 Web 模式参数
# 使用 exec 替换当前 shell，确保信号能正确传递
CMD ["exec", "/tmp/artisan.AppImage", "--web", "--web-host", "0.0.0.0", "--web-port", "8080"]
