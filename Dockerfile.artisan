FROM ubuntu:22.04

# ==========================================
# 1. 环境准备与依赖安装
# ==========================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    libfuse2 \
    libglib2.0-0 \
    libgl1-mesa-glx \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libxfixes3 \
    libxi6 \
    libxxf86vm1 \
    python3 \
    python3-pyqt5 \
    python3-serial \
    python3-requests \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 2. 下载与解压 AppImage
# ==========================================
ARG VERSION=v4.0.2
ENV ARTISAN_URL="https://github.com/artisan-roaster-scope/artisan/releases/download/${VERSION}/artisan-linux-${VERSION#v}.AppImage"

RUN cd /tmp && \
    wget -O artisan.AppImage "${ARTISAN_URL}" && \
    chmod +x artisan.AppImage && \
    ./artisan.AppImage --appimage-extract && \
    mv /tmp/squashfs-root /opt/artisan && \
    rm artisan.AppImage

# ==========================================
# 3. 配置与启动
# ==========================================
WORKDIR /opt/artisan

RUN ln -sf /opt/artisan/AppRun /usr/local/bin/artisan

# ==========================================
# 4. 启动命令
# ==========================================
CMD ["./AppRun", "--web", "--web-host", "0.0.0.0", "--web-port", "8080"]
