FROM ubuntu:22.04

# ==========================================
# 1. 环境准备
# ==========================================
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 基础工具
    wget \
    supervisor \
    # 核心依赖
    libfuse2 \
    libglib2.0-0 \
    libgl1-mesa-glx \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libxfixes3 \
    libxi6 \
    libxxf86vm1 \
    python3 \
    python3-pyqt5 \
    python3-serial \
    python3-requests \
    # 虚拟桌面与浏览器投屏核心组件
    xvfb \
    x11vnc \
    novnc \
    websockify \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 2. 下载并解压 Artisan
# ==========================================
ARG VERSION=v4.0.2
ENV ARTISAN_URL="https://github.com/artisan-roaster-scope/artisan/releases/download/${VERSION}/artisan-linux-${VERSION#v}.AppImage"

RUN apt-get update && apt-get install -y squashfs-tools && rm -rf /var/lib/apt/lists/*

RUN cd /tmp && \
    wget -O artisan.AppImage "${ARTISAN_URL}" && \
    chmod +x artisan.AppImage && \
    unsquashfs -d /opt/artisan artisan.AppImage && \
    rm artisan.AppImage

# ==========================================
# 3. 配置 Supervisor 管理进程
# ==========================================
RUN mkdir -p /etc/supervisor/conf.d/
COPY <<EOF /etc/supervisor/conf.d/supervisord.conf
[supervisord]
nodaemon=true

# 1. 启动虚拟显示器
[program:xvfb]
command=/usr/bin/Xvfb :99 -screen 0 1280x800x24
autorestart=true
priority=100

# 2. 启动 VNC 服务 (监听 5900 端口)
[program:x11vnc]
command=/usr/bin/x11vnc -display :99 -forever -shared -rfbport 5900 -nopw
autorestart=true
priority=200
depends_on=xvfb

# 3. 启动 noVNC (将 VNC 转为 Web 界面，监听 6080 端口)
[program:novnc]
command=/usr/share/novnc/utils/novnc_proxy --vnc localhost:5900 --listen 6080
autorestart=true
priority=300
depends_on=x11vnc

# 4. 启动 Artisan
[program:artisan]
command=/opt/artisan/AppRun
environment=DISPLAY=":99"
autorestart=true
priority=400
depends_on=xvfb
EOF

# ==========================================
# 4. 启动
# ==========================================
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
