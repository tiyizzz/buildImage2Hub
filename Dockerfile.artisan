FROM debian:bookworm-slim

ARG VERSION

# ==========================================
# 1. 基础环境 & 源地址修复
# ==========================================
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources && \
    echo "deb http://mirrors.aliyun.com/debian/ bookworm main contrib non-free non-free-firmware" > /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian/ bookworm-updates main contrib non-free non-free-firmware" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian-security bookworm-security main contrib non-free non-free-firmware" >> /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates gnupg && \
    rm -rf /var/lib/apt/lists/*

# ==========================================
# 2. 下载 Artisan (带哈希校验)
# ==========================================
RUN \
    STRIPPED_VERSION=${VERSION#v} && \
    DOWNLOAD_URL="https://github.com/artisan-roaster-scope/artisan/releases/download/${VERSION}/artisan-linux-${STRIPPED_VERSION}.deb" && \
    echo "📥 正在下载: ${DOWNLOAD_URL}" && \
    # 下载文件
    wget -O /tmp/artisan.deb "${DOWNLOAD_URL}" && \
    # 🔍 关键修改：输出文件的 SHA256 值和大小
    echo "🔍 文件校验信息:" && \
    ls -lh /tmp/artisan.deb && \
    sha256sum /tmp/artisan.deb && \
    # 检查文件大小，如果小于 1MB，说明下载可能失败（真正的包通常有几十 MB）
    FILE_SIZE=$(stat -c%s "/tmp/artisan.deb") && \
    if [ "$FILE_SIZE" -lt 1000000 ]; then \
      echo "❌ 错误：文件太小 (${FILE_SIZE} 字节)，可能下载失败！"; \
      exit 1; \
    fi && \
    echo "✅ 文件检查通过"

# ==========================================
# 3. 安装全量依赖
# ==========================================
# 这一步确保所有可能的依赖都已安装，减少 dpkg 的阻力
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources && \
    echo "deb http://mirrors.aliyun.com/debian/ bookworm main contrib non-free non-free-firmware" > /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian/ bookworm-updates main contrib non-free non-free-firmware" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian-security bookworm-security main contrib non-free non-free-firmware" >> /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    # 基础工具
    curl xvfb xauth \
    # Qt5 核心
    libqt5core5a \
    libqt5gui5 \
    libqt5widgets5 \
    libqt5serialport5 \
    libqt5network5 \
    libqt5printsupport5 \
    libqt5svg5 \
    libqt5multimedia5 \
    libqt5multimedia5-plugins \
    # Python 3 (Artisan 核心依赖)
    python3 \
    python3-pyqt5 \
    python3-pyqt5.qtserialport \
    python3-serial \
    # GStreamer (多媒体/声音)
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    # 其他系统库
    libmodbus-dev \
    libusb-1.0-0-dev \
    udev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 4. 强制安装 Artisan
# ==========================================
# 关键修改：使用 --force-depends 忽略依赖检查，先让文件落地
RUN dpkg --force-depends -i /tmp/artisan.deb && \
    # 然后再运行 apt-get -f install 来补全缺失的依赖
    apt-get -f install -y && \
    rm -f /tmp/artisan.deb

# ==========================================
# 5. 验证
# ==========================================
RUN if [ ! -f /usr/local/bin/artisan ]; then \
      echo "❌ 安装失败：找不到二进制文件"; exit 1; \
    fi

CMD ["xvfb-run", "-a", "/usr/local/bin/artisan", "--web", "--web-host", "0.0.0.0", "--web-port", "8080"]
