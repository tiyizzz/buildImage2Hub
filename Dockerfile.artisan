FROM ubuntu:22.04

ARG VERSION

# ==========================================
# 1. 基础环境准备
# ==========================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 2. 下载 Artisan
# ==========================================
RUN \
    STRIPPED_VERSION=${VERSION#v} && \
    DOWNLOAD_URL="https://github.com/artisan-roaster-scope/artisan/releases/download/${VERSION}/artisan-linux-${STRIPPED_VERSION}.deb" && \
    echo "📥 正在下载: ${DOWNLOAD_URL}" && \
    wget -O /tmp/artisan.deb "${DOWNLOAD_URL}" && \
    ls -lh /tmp/artisan.deb && \
    sha256sum /tmp/artisan.deb

# ==========================================
# 3. 安装依赖
# ==========================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl xvfb xauth \
    libqt5core5a \
    libqt5gui5 \
    libqt5widgets5 \
    libqt5serialport5 \
    libqt5network5 \
    libqt5printsupport5 \
    libqt5svg5 \
    libqt5multimedia5 \
    libqt5multimedia5-plugins \
    python3 \
    python3-pyqt5 \
    python3-pyqt5.qtserialport \
    python3-serial \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    libmodbus-dev \
    libusb-1.0-0-dev \
    udev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 4. 暴力安装 (关键修改)
# ==========================================
# 1. 尝试用 apt-get 直接安装本地文件 (比 dpkg 更智能)
# 2. 如果失败，强制运行 dpkg -i (忽略错误)
# 3. 再次运行 apt-get -f install 修复依赖
# 4. 删除 dpkg --configure -a (避免死循环报错)
RUN apt-get install -y -f /tmp/artisan.deb || \
    (dpkg -i /tmp/artisan.deb && apt-get -f install -y) || \
    true && \
    rm -f /tmp/artisan.deb

# ==========================================
# 5. 验证
# ==========================================
RUN if [ ! -f /usr/local/bin/artisan ]; then \
      echo "❌ 安装失败：找不到二进制文件"; exit 1; \
    fi

CMD ["xvfb-run", "-a", "/usr/local/bin/artisan", "--web", "--web-host", "0.0.0.0", "--web-port", "8080"]
