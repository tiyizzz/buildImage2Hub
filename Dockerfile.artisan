FROM ubuntu:22.04

# ==========================================
# 1. 环境准备与依赖安装
# ==========================================
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    supervisor \
    libfuse2 \
    libglib2.0-0 \
    libgl1-mesa-glx \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libxfixes3 \
    libxi6 \
    libxxf86vm1 \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    python3 \
    python3-pyqt5 \
    python3-serial \
    python3-requests \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 2. 下载 AppImage (仅下载，不解压)
# ==========================================
ARG VERSION=v4.0.2
ENV ARTISAN_URL="https://github.com/artisan-roaster-scope/artisan/releases/download/${VERSION}/artisan-linux-${VERSION#v}.AppImage"

# 修正点：这里只下载并赋予权限，绝对不进行解压操作
RUN cd /tmp && \
    wget -O /tmp/artisan.AppImage "${ARTISAN_URL}" && \
    chmod +x /tmp/artisan.AppImage

# ==========================================
# 3. 配置 Supervisor 管理进程
# ==========================================
RUN mkdir -p /etc/supervisor/conf.d/

# 编写 supervisor 配置文件
COPY <<EOF /etc/supervisor/conf.d/supervisord.conf
[supervisord]
nodaemon=true

# 1. 启动虚拟显示器 (分辨率 1280x800)
[program:xvfb]
command=/usr/bin/Xvfb :99 -screen 0 1280x800x24
autorestart=true
priority=100

# 2. 启动 VNC 服务 (监听 5900 端口)
[program:x11vnc]
command=/usr/bin/x11vnc -display :99 -forever -shared -rfbport 5900 -nopw
autorestart=true
priority=200
depends_on=xvfb

# 3. 启动 noVNC (将 VNC 转为 Web，监听 6080 端口)
[program:novnc]
command=/usr/share/novnc/utils/novnc_proxy --vnc localhost:5900 --listen 6080
autorestart=true
priority=300
depends_on=x11vnc

# 4. 启动 Artisan (直接运行 AppImage)
[program:artisan]
command=/tmp/artisan.AppImage
environment=DISPLAY=":99"
autorestart=true
priority=400
depends_on=xvfb
EOF

# ==========================================
# 4. 启动
# ==========================================
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
