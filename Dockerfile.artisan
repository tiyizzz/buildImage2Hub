FROM ubuntu:22.04

ARG VERSION

# ==========================================
# 1. 基础环境准备
# ==========================================
# 使用 Ubuntu 22.04 以获得更好的兼容性
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 2. 下载 Artisan (带哈希校验)
# ==========================================
RUN \
    STRIPPED_VERSION=${VERSION#v} && \
    DOWNLOAD_URL="https://github.com/artisan-roaster-scope/artisan/releases/download/${VERSION}/artisan-linux-${STRIPPED_VERSION}.deb" && \
    echo "📥 正在下载: ${DOWNLOAD_URL}" && \
    # 下载文件
    wget -O /tmp/artisan.deb "${DOWNLOAD_URL}" && \
    # 🔍 关键修改：输出文件的 SHA256 值和大小
    echo "🔍 文件校验信息:" && \
    ls -lh /tmp/artisan.deb && \
    sha256sum /tmp/artisan.deb && \
    # 检查文件大小，如果小于 1MB，说明下载可能失败（真正的包通常有几十 MB）
    FILE_SIZE=$(stat -c%s "/tmp/artisan.deb") && \
    if [ "$FILE_SIZE" -lt 1000000 ]; then \
      echo "❌ 错误：文件太小 (${FILE_SIZE} 字节)，可能下载失败！"; \
      exit 1; \
    fi && \
    echo "✅ 文件检查通过"

# ==========================================
# 3. 安装依赖
# ==========================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl xvfb xauth \
    libqt5core5a \
    libqt5gui5 \
    libqt5widgets5 \
    libqt5serialport5 \
    libqt5network5 \
    libqt5printsupport5 \
    libqt5svg5 \
    libqt5multimedia5 \
    libqt5multimedia5-plugins \
    python3 \
    python3-pyqt5 \
    python3-pyqt5.qtserialport \
    python3-serial \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    libmodbus-dev \
    libusb-1.0-0-dev \
    udev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 4. 强制安装 (绕过脚本错误)
# ==========================================
# 1. 使用 dpkg -i 安装
# 2. 如果失败（通常是因为 postinst 脚本报错），我们忽略它
# 3. 使用 dpkg --configure -a 强制完成配置
RUN dpkg -i /tmp/artisan.deb || true && \
    dpkg --configure -a && \
    apt-get -f install -y && \
    rm -f /tmp/artisan.deb

# ==========================================
# 5. 验证
# ==========================================
RUN if [ ! -f /usr/local/bin/artisan ]; then \
      echo "❌ 安装失败：找不到二进制文件"; exit 1; \
    fi

CMD ["xvfb-run", "-a", "/usr/local/bin/artisan", "--web", "--web-host", "0.0.0.0", "--web-port", "8080"]
