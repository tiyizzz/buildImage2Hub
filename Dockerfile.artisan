FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# ==========================================
# 1. 环境准备与依赖安装
# ==========================================
# 修正点：增加了 libxcb*, libdbus* 等关键底层库
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    supervisor \
    libfuse2 \
    libglib2.0-0 \
    libgl1-mesa-glx \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libxfixes3 \
    libxi6 \
    libxxf86vm1 \
    libxcb-xinerama0 \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-keysyms1 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxcb-render-util0 \
    libdbus-1-3 \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    python3 \
    python3-pyqt5 \
    python3-serial \
    python3-requests \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 2. 下载 AppImage
# ==========================================
ARG VERSION=v4.0.2
ENV ARTISAN_URL="https://github.com/artisan-roaster-scope/artisan/releases/download/${VERSION}/artisan-linux-${VERSION#v}.AppImage"

RUN cd /tmp && \
    wget -O /tmp/artisan.AppImage "${ARTISAN_URL}" && \
    chmod +x /tmp/artisan.AppImage

# ==========================================
# 3. 配置 Supervisor
# ==========================================
RUN mkdir -p /etc/supervisor/conf.d/

# 修正点：增加了 --debug 参数，这样如果还报错，我们能在日志里看到具体缺什么
COPY <<EOF /etc/supervisor/conf.d/supervisord.conf
[supervisord]
nodaemon=true

[program:xvfb]
command=/usr/bin/Xvfb :99 -screen 0 1280x800x24
autorestart=true
priority=100

[program:x11vnc]
command=/usr/bin/x11vnc -display :99 -forever -shared -rfbport 5900 -nopw
autorestart=true
priority=200
depends_on=xvfb

[program:novnc]
command=/usr/bin/websockify --web=/usr/share/novnc/ 6080 localhost:5900
autorestart=true
priority=300
depends_on=x11vnc

[program:artisan]
# 增加了 --debug 参数用于输出详细日志
command=/tmp/artisan.AppImage --debug
environment=DISPLAY=":99",PYTHONPATH="/usr/lib/python3.10:/usr/lib/python3"
autorestart=true
priority=400
depends_on=xvfb
EOF

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
