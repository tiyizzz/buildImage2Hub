FROM debian:bookworm-slim

# 国内镜像加速
RUN sed -i "s@deb.debian.org@mirrors.tuna.tsinghua.edu.cn@g" /etc/apt/sources.list && \
    sed -i "s@security.debian.org@mirrors.tuna.tsinghua.edu.cn@g" /etc/apt/sources.list

# 安装依赖
RUN apt update && apt install -y --no-install-recommends \
    wget \
    libqt5core5a \
    libqt5gui5 \
    libqt5widgets5 \
    libqt5serialport5 \
    libqt5network5 \
    libqt5printsupport5 \
    libqt5svg5 \
    libmodbus-dev \
    libusb-1.0-0-dev \
    udev \
    && rm -rf /var/lib/apt/lists/*

# 自动下载最新版
RUN wget -q https://github.com/artisan-roaster-scope/artisan/releases/latest/download/artisan-linux.deb -O /tmp/artisan.deb && \
    dpkg -i /tmp/artisan.deb || apt -f install -y && \
    rm -f /tmp/artisan.deb

# Web 启动
CMD ["artisan", "--web", "--web-host", "0.0.0.0", "--web-port", "8080"]
